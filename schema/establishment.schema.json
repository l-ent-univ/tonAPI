    "MatchRule": {
      "additionalProperties": false,
      "description": "Une règle : un signal du profil et un motif. Renseigner exactement un de `contains`, `prefix`, `suffix`.\n\nLa comparaison ignore la casse, les accents et les espaces multiples ; un `?` ou `�` dans le signal\n(accent mal encodé par le serveur) correspond à n'importe quel caractère.",
      "properties": {
        "contains": {
          "description": "Le signal contient ce texte.",
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "description": "Le signal commence par ce texte.",
          "type": [
            "string",
            "null"
          ]
        },
        "signal": {
          "$ref": "#/$defs/SignalSource",
          "description": "Signal comparé."
        },
        "suffix": {
          "description": "Le signal finit par ce texte.",
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "default": 1,
          "description": "Poids de la règle. Défaut : 1.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "signal"
      ],
      "type": "object"
    },
    "MoodleEntry": {
      "description": "Entrée de connexion d'un Moodle.",
