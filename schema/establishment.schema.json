    "ServiceOptions": {
      "additionalProperties": false,
      "description": "Réglages communs à tous les fournisseurs distants. Tous facultatifs.",
      "properties": {
        "cache-ttl-secs": {
          "description": "Durée, en secondes, pendant laquelle un client peut garder la réponse du service sans la\nredemander (`meta.cacheSecs`). `0` : jamais. Défaut propre au service. Le serveur, lui, ne\ngarde aucune réponse.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout-secs": {
          "description": "Délai maximal d'une requête, en secondes. Défaut : 20.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Services": {
      "additionalProperties": false,
      "description": "Services, tous facultatifs. Un service absent n'est pas proposé ; dans un fichier de composante, un\nservice absent reprend celui de l'université.",
      "properties": {
        "absences": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsencesService"
