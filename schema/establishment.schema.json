              "const": "separate",
              "type": "string"
            },
            "label": {
              "description": "Ce qu'on demande à l'étudiant (ex. « Identifiant IUT (prenom.nom) »).",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "DocumentsService": {
      "description": "Documents administratifs.",
