              "type": "string"
            }
          },
          "required": [
            "provider",
            "base-url",
            "service-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Simple lien vers le site de l'établissement.",
          "properties": {
            "label": {
              "description": "Libellé du lien.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "description": "Page à ouvrir.",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Service non proposé.",
          "properties": {
            "provider": {
              "const": "none",
              "type": "string"
            }
