{
  "$defs": {
    "AbsencesService": {
      "description": "Absences.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Passerelle ScoDoc des IUT.",
          "properties": {
            "base-url": {
              "description": "Racine de la passerelle (ex. `https://notes.iut.exemple.fr/`).",
              "format": "uri",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/ServiceOptions"
            },
            "provider": {
              "const": "scodoc-gateway",
              "type": "string"
            },
            "sign-in": {
              "$ref": "#/$defs/SignIn",
              "description": "Connexion. Défaut : CAS de l'université."
            }
          },
          "required": [
            "provider",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Simple lien vers le site de l'établissement.",
          "properties": {
            "label": {
              "description": "Libellé du lien.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "description": "Page à ouvrir.",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Service non proposé.",
          "properties": {
            "provider": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Données fictives de l'université de démonstration.",
          "properties": {
            "provider": {
              "const": "demo",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "Affiliation": {
      "additionalProperties": false,
      "description": "Règles de rattachement automatique.",
