  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fichier `universities/<université>/establishments/<id>.toml` : une composante (IUT, UFR, faculté)\ndont les étudiants n'ont pas tout à fait les mêmes services que le reste de l'université.\n\nSeuls `id` et `name` sont obligatoires.",
  "properties": {
    "affiliation": {
      "$ref": "#/$defs/Affiliation",
      "default": {
        "rules": []
      },
      "description": "Règles de rattachement automatique. Sans règle, l'étudiant choisit lui-même."
    },
    "default": {
      "default": false,
      "description": "Composante choisie quand aucune règle de rattachement ne correspond. Une seule par université.",
      "type": "boolean"
    },
    "id": {
      "description": "Identifiant stable, identique au nom du fichier sans `.toml` (`a-z`, `0-9`, `-`).",
      "type": "string"
    },
    "links": {
      "$ref": "#/$defs/Links",
      "default": {},
      "description": "Liens propres à la composante."
    },
    "name": {
      "description": "Nom complet affiché à l'étudiant.",
      "type": "string"
    },
    "schema-version": {
      "default": 1,
      "description": "Version du format. Vaut 1.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "services": {
      "$ref": "#/$defs/Services",
      "default": {},
      "description": "Services qui remplacent ceux de l'université pour les étudiants de la composante."
    },
    "short-name": {
      "description": "Nom court.",
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "active",
      "description": "Avancement de la prise en charge."
    },
    "tls": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tls"
        },
        {
          "type": "null"
        }
      ],
      "description": "Réglages TLS propres aux serveurs de la composante."
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "EstablishmentFile",
  "type": "object"
}
