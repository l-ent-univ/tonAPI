    "CasFlavor": {
      "description": "Logiciel CAS, qui détermine la forme du formulaire et des redirections.",
      "oneOf": [
        {
          "const": "apereo",
          "description": "Apereo CAS 5 à 7 : formulaire avec `execution`.",
          "type": "string"
        },
        {
          "const": "esup-otp-gateway",
          "description": "esup-otp-cas-server devant Apereo CAS : `/cas` puis `/pre-otp`, rappel `login-<md5(service)>`.",
          "type": "string"
        },
        {
          "const": "phpcas",
          "description": "phpCAS / CAS 1-2 : formulaire avec jeton `lt`.",
          "type": "string"
        }
      ]
    },
    "Credentials": {
      "description": "Identifiants demandés à l'étudiant.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Ceux du compte de l'université.",
          "properties": {
            "kind": {
              "const": "university",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Un autre compte, propre à la composante.",
          "properties": {
            "kind": {
              "const": "separate",
              "type": "string"
            },
            "label": {
              "description": "Ce qu'on demande à l'étudiant (ex. « Identifiant IUT (prenom.nom) »).",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "DocumentsService": {
      "description": "Documents administratifs.",
