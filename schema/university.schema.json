          "properties": {
            "base-url": {
              "description": "Racine du serveur ADE (ex. `https://planning.exemple.fr/`).",
              "format": "uri",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/ServiceOptions"
            },
            "project-id": {
              "default": 1,
              "description": "Projet ADE. Défaut : 1.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "provider": {
              "const": "ade-myplanning",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Simple lien vers le site de l'établissement.",
          "properties": {
            "label": {
              "description": "Libellé du lien.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "description": "Page à ouvrir.",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Service non proposé.",
          "properties": {
            "provider": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Données fictives de l'université de démonstration.",
          "properties": {
            "provider": {
              "const": "demo",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "Tls": {
      "additionalProperties": false,
      "description": "Réglages TLS.",
      "properties": {
        "extra-ca": {
          "default": [],
          "description": "Certificats PEM à ajouter aux autorités reconnues, relatifs au dossier de l'université.\nSert aux serveurs qui n'envoient pas leur certificat intermédiaire.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fichier `universities/<id>/university.toml`.\n\nSeuls `id`, `name` et `sso` sont obligatoires ; un service absent n'est pas proposé.",
  "properties": {
    "id": {
      "description": "Identifiant stable, identique au nom du dossier (`a-z`, `0-9`, `-`).",
      "type": "string"
    },
    "links": {
      "$ref": "#/$defs/Links",
      "default": {},
      "description": "Liens utiles affichés tels quels."
    },
