            "kind": {
              "const": "local-password",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Sso": {
      "description": "Connexion unique.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Serveur CAS.",
          "properties": {
            "base-url": {
              "description": "Racine du serveur, sans `/login` (ex. `https://cas.exemple.fr/cas/`).",
              "format": "uri",
              "type": "string"
            },
            "flavor": {
              "$ref": "#/$defs/CasFlavor",
              "default": "apereo",
              "description": "Logiciel CAS. `apereo` convient à la plupart des universités."
            },
            "kind": {
              "const": "cas",
              "type": "string"
            },
            "mfa": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MfaConfig"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Second facteur, quand l'université en demande un."
            },
            "saml": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SamlConfig"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fédération SAML (Shibboleth) branchée sur ce CAS, pour Moodle ou le mail."
            }
          },
          "required": [
            "kind",
            "base-url"
          ],
          "type": "object"
        },
        {
          "description": "Connexion factice de l'université de démonstration (identifiants `demo` / `demo`).",
          "properties": {
            "kind": {
              "const": "demo",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Status": {
      "description": "Avancement de la prise en charge d'une université ou d'une composante.",
      "oneOf": [
        {
          "const": "active",
          "description": "Testée avec un vrai compte.",
          "type": "string"
        },
        {
          "const": "beta",
          "description": "Configurée d'après la documentation, pas encore testée de bout en bout.",
          "type": "string"
        },
        {
          "const": "planned",
          "description": "Annoncée, non utilisable.",
          "type": "string"
        }
      ]
    },
    "TimetableService": {
      "description": "Emploi du temps.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Flux iCal ADE (`direct_cal.jsp?data=…`) dont le lien est lu sur une page authentifiée.",
          "properties": {
            "feed-host": {
              "description": "Hôte du serveur ADE qui sert le flux.",
              "type": "string"
            },
            "link-page": {
              "description": "Page, derrière le CAS, qui contient le lien du flux.",
              "format": "uri",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/ServiceOptions"
            },
            "provider": {
              "const": "ade-ical-link",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "link-page",
            "feed-host"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "API REST du portail ADE (`/portal/RestApi/`), après connexion CAS.",
          "properties": {
            "base-url": {
              "description": "Racine du portail ADE (ex. `https://planning.exemple.fr/portal/`).",
              "format": "uri",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/ServiceOptions"
            },
            "provider": {
              "const": "ade-portal-rest",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
