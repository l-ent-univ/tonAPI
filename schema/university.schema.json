    "HomeworkService": {
      "description": "Devoirs et échéances.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Web service Moodle (`/webservice/rest/server.php`) avec un jeton.",
          "properties": {
            "base-url": {
              "description": "Racine du Moodle (ex. `https://moodle.exemple.fr/`).",
