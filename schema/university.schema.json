      "description": "Nom complet affiché à l'étudiant.",
      "type": "string"
    },
    "portal": {
      "$ref": "#/$defs/PortalConfig",
      "default": {
        "kind": "none"
      },
      "description": "Portail (ENT) : liste des applications et profil."
    },
    "schema-version": {
      "default": 1,
      "description": "Version du format. Vaut 1.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "services": {
      "$ref": "#/$defs/Services",
      "default": {},
      "description": "Services proposés à tous les étudiants, sauf remplacement par une composante."
    },
    "short-name": {
      "description": "Nom court (sigle).",
      "type": [
        "string",
        "null"
      ]
    },
    "sso": {
      "$ref": "#/$defs/Sso",
      "description": "Connexion unique de l'université."
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "active",
      "description": "Avancement de la prise en charge."
    },
    "timezone": {
      "default": "Europe/Paris",
      "description": "Fuseau horaire IANA des données (emploi du temps, échéances).",
      "type": "string"
    },
    "tls": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tls"
        },
        {
          "type": "null"
        }
      ],
      "description": "Réglages TLS pour les serveurs mal configurés."
    }
  },
  "required": [
    "id",
    "name",
    "sso"
  ],
  "title": "UniversityFile",
  "type": "object"
}
