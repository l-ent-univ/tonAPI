            "provider": {
              "const": "demo",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "SamlConfig": {
      "additionalProperties": false,
      "description": "Passage par une fédération SAML : fournisseur de service → WAYF → IdP → CAS.",
      "properties": {
        "allowed-hosts": {
          "description": "Suffixes de nom d'hôte autorisés pendant les redirections (ex. `renater.fr`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idp-entity-id": {
          "description": "entityID de l'IdP de l'université, choisi dans le WAYF.",
          "type": "string"
        },
        "wayf-url": {
          "description": "Service de découverte (WAYF).",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "wayf-url",
        "idp-entity-id",
        "allowed-hosts"
      ],
      "type": "object"
    },
    "ServiceOptions": {
      "additionalProperties": false,
      "description": "Réglages communs à tous les fournisseurs distants. Tous facultatifs.",
      "properties": {
        "cache-ttl-secs": {
          "description": "Durée de cache des réponses, en secondes. Défaut propre au fournisseur.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout-secs": {
          "description": "Délai maximal d'une requête, en secondes. Défaut : 20.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Services": {
      "additionalProperties": false,
      "description": "Services, tous facultatifs. Un service absent n'est pas proposé ; dans un fichier de composante, un\nservice absent reprend celui de l'université.",
      "properties": {
        "absences": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsencesService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absences."
        },
        "apps": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppsService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Applications du portail."
        },
        "documents": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentsService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Documents (certificat de scolarité, attestations)."
        },
        "grades": {
          "anyOf": [
            {
              "$ref": "#/$defs/GradesService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Notes."
        },
        "homework": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomeworkService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Devoirs et échéances."
        },
        "mail": {
          "anyOf": [
            {
              "$ref": "#/$defs/MailService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Messagerie."
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Profil (nom, adresse, composante)."
        },
        "timetable": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimetableService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Emploi du temps."
        }
      },
      "type": "object"
    },
    "SignIn": {
      "description": "Manière d'ouvrir une session sur le service.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "CAS de l'université. Le service CAS se déduit de l'URL du fournisseur ; `service` le remplace.",
          "properties": {
            "kind": {
              "const": "university-cas",
              "type": "string"
            },
            "service": {
              "description": "URL de service CAS, si elle diffère de celle déduite.",
              "format": "uri",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "CAS propre à la composante.",
          "properties": {
            "base-url": {
              "description": "Racine du CAS de la composante.",
              "format": "uri",
              "type": "string"
            },
            "credentials": {
              "$ref": "#/$defs/Credentials",
              "default": {
                "kind": "university"
              },
              "description": "Identifiants demandés."
            },
            "flavor": {
              "$ref": "#/$defs/CasFlavor",
              "default": "apereo",
              "description": "Logiciel CAS."
            },
            "kind": {
              "const": "own-cas",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Identifiant et mot de passe envoyés directement au service (ex. `login/token.php` de Moodle).",
          "properties": {
            "credentials": {
              "$ref": "#/$defs/Credentials",
              "default": {
