    "MfaConfig": {
      "additionalProperties": false,
      "description": "Second facteur esup-otp.",
      "properties": {
        "api-url": {
          "description": "Racine de l'API esup-otp-api.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "api-url"
      ],
      "type": "object"
    },
    "MoodleEntry": {
      "description": "Entrée de connexion d'un Moodle.",
      "oneOf": [
        {
          "const": "cas",
          "description": "`/login/index.php?authCAS=CAS`.",
          "type": "string"
        },
        {
          "const": "shibboleth",
          "description": "`/auth/shibboleth/index.php`, via la fédération SAML de l'université.",
          "type": "string"
        }
      ]
    },
    "PortalConfig": {
      "description": "Portail (ENT).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "uPortal 4 avec ESUP ProlongationENT (`layout.jsp` en JSONP).",
          "properties": {
            "base-url": {
              "description": "Racine uPortal (ex. `https://ent.exemple.fr/uPortal/`).",
              "format": "uri",
              "type": "string"
            },
            "kind": {
              "const": "uportal4-prolongation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "uPortal 5 (`/api/v4-3/dlm/layout.json`, `/api/v5-1/userinfo`).",
          "properties": {
            "base-url": {
              "description": "Racine du portail.",
              "format": "uri",
              "type": "string"
            },
            "kind": {
              "const": "uportal5",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Portail à tuiles avec client CAS intégré : entrée `cas/login?next=/`, profil\n`api/cas-attributes`, applications `api/tiles`. Logiciel non identifié (vu à Montpellier,\noctobre 2026).",
          "properties": {
            "base-url": {
              "description": "Racine du portail (ex. `https://ent.exemple.fr/`).",
              "format": "uri",
              "type": "string"
            },
            "kind": {
              "const": "tiles-portal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "base-url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pas de portail exploitable.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ProfileService": {
      "description": "Profil.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Lu dans le portail déclaré dans `[portal]`.",
          "properties": {
            "provider": {
              "const": "portal",
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
